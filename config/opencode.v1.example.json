{
  "$schema": "https://opencode.ai/config.json",
  "model": "codendum/coder",
  "share": "disabled",
  "provider": {
    "codendum": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Codendum (local)",
      "options": {
        "baseURL": "https://llm.lab.example:8443/v1",
        "apiKey": "{env:CODENDUM_API_KEY}"
      },
      "models": {
        "coder": {
          "name": "Qwen3-Coder 30B-A3B FP8 (Codendum)",
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
