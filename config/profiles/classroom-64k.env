# Profile: classroom-64k
# Default for a shared classroom or team service. Starting point to measure,
# not a performance guarantee. Clients: OpenCode limit.context = 65536.
CODENDUM_MAX_MODEL_LEN=65536
CODENDUM_MAX_NUM_SEQS=16
CODENDUM_MAX_NUM_BATCHED_TOKENS=8192
CODENDUM_GPU_MEMORY_UTILIZATION=0.80
CODENDUM_KV_CACHE_DTYPE=fp8
CODENDUM_CLIENT_CONTEXT_LIMIT=65536
CODENDUM_CLIENT_OUTPUT_LIMIT=8192
