# Profile: deep-128k
# Fewer users working on large contexts (whole-module refactoring, long
# sessions). Requires the coordinated client change OpenCode
# limit.context = 131072. Very long prefills are slow and memory-hungry.
CODENDUM_MAX_MODEL_LEN=131072
CODENDUM_MAX_NUM_SEQS=8
CODENDUM_MAX_NUM_BATCHED_TOKENS=8192
CODENDUM_GPU_MEMORY_UTILIZATION=0.80
CODENDUM_KV_CACHE_DTYPE=fp8
CODENDUM_CLIENT_CONTEXT_LIMIT=131072
CODENDUM_CLIENT_OUTPUT_LIMIT=8192
