# Profile: classroom-64k-high-concurrency
# More simultaneously active requests at the same context limit. Relies on
# most requests being much shorter than 64K tokens; long requests at high
# concurrency cause preemption. Measure with scripts/bench.sh before use.
# Clients: OpenCode limit.context = 65536.
CODENDUM_MAX_MODEL_LEN=65536
CODENDUM_MAX_NUM_SEQS=24
CODENDUM_MAX_NUM_BATCHED_TOKENS=8192
CODENDUM_GPU_MEMORY_UTILIZATION=0.80
CODENDUM_KV_CACHE_DTYPE=fp8
CODENDUM_CLIENT_CONTEXT_LIMIT=65536
CODENDUM_CLIENT_OUTPUT_LIMIT=8192
