{
  "$schema": "https://opencode.ai/config.json",
  "model": "codendum/coder",
  "share": "disabled",
  "providers": {
    "codendum": {
      "name": "Codendum (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://llm.lab.example:8443/v1",
        "apiKey": "{env:CODENDUM_API_KEY}"
      },
      "models": {
        "coder": {
          "modelID": "coder",
          "name": "Qwen3-Coder 30B-A3B FP8 (Codendum)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
