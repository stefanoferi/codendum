# Codendum server configuration (example).
#
# Copy to .env on the GB10 host and adjust:  cp .env.example .env
# .env is ignored by Git. It must not contain secrets: tokens go in the
# secrets file referenced by CODENDUM_SECRETS_ENV_FILE (see README).
#
# Only CODENDUM_* variables are read. Values already exported in the shell
# take precedence over this file; this file takes precedence over the profile.
# To use another file, pass --env-file FILE or export CODENDUM_ENV_FILE=FILE.

# Serving profile: classroom-64k | classroom-64k-high-concurrency | deep-128k
CODENDUM_PROFILE=classroom-64k

# vLLM container image, pinned by tag AND digest for reproducible installs.
# vllm/vllm-openai v0.30.0 (multi-arch index incl. linux/arm64, CUDA 13.0.2).
# See "Upgrading" in README.md before changing it.
CODENDUM_VLLM_IMAGE=vllm/vllm-openai:v0.30.0@sha256:8a69ffad015f138d7170c4ddc429e230a3bc1c1719f67e14324749df200a4b90

# Model checkpoint and the exact Hugging Face revision (commit) to load.
CODENDUM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
CODENDUM_MODEL_REVISION=dcaee4d4dfc5ee71ad501f01f530e5652438fde0

# Name clients use in the "model" field (OpenCode modelID).
CODENDUM_SERVED_MODEL_NAME=coder

# Container name. start-vllm.sh never replaces an existing container unless
# --replace is given.
CODENDUM_CONTAINER_NAME=codendum-vllm

# The API listens on the loopback interface only; nginx is the only way in.
# If you change the port, change the upstream in the nginx configuration too.
CODENDUM_HOST=127.0.0.1
CODENDUM_PORT=8000

# Persistent Hugging Face cache on the host (about 30 GiB for this model).
# Create it once:  sudo install -d -m 0755 -o "$USER" /var/lib/codendum/huggingface
CODENDUM_HF_CACHE_DIR=/var/lib/codendum/huggingface

# Optional file with secrets passed to the container through --env-file,
# for example HF_TOKEN=... (only for gated models) or VLLM_API_KEY=...
# Keep it outside the repository, readable only by the user who runs
# start-vllm.sh (mode 0600). Leave empty if unused.
CODENDUM_SECRETS_ENV_FILE=

# Set to 1 after the first successful download so restarts never reach the Hub.
CODENDUM_HF_OFFLINE=0

# Docker restart policy for the container.
CODENDUM_RESTART_POLICY=unless-stopped

# Tool-call parser for Qwen3-Coder. In vLLM >= 0.25 "qwen3_coder" and
# "qwen3_xml" select the same parser.
CODENDUM_TOOL_CALL_PARSER=qwen3_coder

# Seconds between SSE keep-alive comments while a streamed request is queued
# or in prefill, so that the proxy does not time out (0 disables).
CODENDUM_SSE_KEEPALIVE_SECONDS=15

# Optional bound on requests waiting or running inside vLLM. Beyond it vLLM
# answers HTTP 503 instead of queueing without limit. Empty = unbounded.
CODENDUM_MAX_NUM_QUEUED_REQS=

# HTTPS proxy (nginx in Docker, see scripts/start-proxy.sh). The port is set by
# the "listen" directive in $CODENDUM_PROXY_DIR/conf.d/codendum.conf (8443).
# nginx 1.30.5 (stable), Alpine variant, multi-arch index incl. linux/arm64.
CODENDUM_PROXY_IMAGE=nginx:1.30.5-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
CODENDUM_PROXY_CONTAINER_NAME=codendum-proxy
CODENDUM_PROXY_DIR=/etc/codendum/proxy

# Optional overrides of the selected profile (leave commented to use the profile).
# CODENDUM_MAX_MODEL_LEN=65536
# CODENDUM_MAX_NUM_SEQS=16
# CODENDUM_MAX_NUM_BATCHED_TOKENS=8192
# CODENDUM_GPU_MEMORY_UTILIZATION=0.80
# CODENDUM_KV_CACHE_DTYPE=fp8

# Extra arguments appended to "vllm serve" (advanced; never put secrets here).
# Split on whitespace without shell quoting, so values cannot contain spaces.
CODENDUM_VLLM_EXTRA_ARGS=

# Seconds allowed for startup, first model download included: how long
# "start-vllm.sh --wait" waits for /health, and the Docker health-check grace
# period. About 31 GB are downloaded on the first start; raise this value on
# slow connections (at 5 MB/s the download alone takes about 100 minutes).
CODENDUM_START_TIMEOUT=3600
